{
  "manifest_version": 3,
  "name": "Flow Unlocker (RU)",
  "version": "2.1.0",
  "description": "Разблокировка Google Flow (flow.google.com) и включение русского языка. Автор: nickitafedorov2012",
  "author": "nickitafedorov2012-code",
  "homepage_url": "https://github.com/nickitafedorov2012-code/xkeen-ui-ext",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "http://flow.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flow Unlocker (RU) — nickitafedorov2012",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "http://flow.google.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
