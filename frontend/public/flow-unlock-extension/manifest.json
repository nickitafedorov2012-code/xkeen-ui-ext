{
  "manifest_version": 3,
  "name": "Flow Unlocker",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "Разблокировка Google Flow (flow.google.com). Автор: nickitafedorov2012",
  "author": "nickitafedorov2012-code",
  "homepage_url": "https://github.com/nickitafedorov2012-code/xkeen-ui-ext",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://flow.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flow Unlocker — nickitafedorov2012",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "status.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
