+use crate::worker::WORKERS_PER_CREDENTIAL;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct WanTarget {
+    pub mark: u32,
+    pub weight: u32,
+    pub bind_ip: Option<IpAddr>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct WanUpdateOutcome {
+    pub dropped_marks: HashSet<u32>,
+    pub rebalance_needed: bool,
+}
+
+#[derive(Default)]
+struct WanState {
+    targets: Vec<WanTarget>,
+    version: u64,
+    worker_marks: HashMap<usize, u32>,
+    ready_marks: HashMap<usize, u32>,
+    force_cancel_workers: HashSet<usize>,
+    migration_gen: u64,
+}
+
+pub struct WanRouter {
+    state: RwLock<WanState>,
+    tx: watch::Sender<u64>,
+    local_proxy_port: Mutex<Option<u16>>,
+}
+
+/// Разбирает строку `<mark>:<weight>[@<ip>],...` (поддерживает hex `0x...` и dec).
+pub fn parse_wan_marks(spec: &str) -> Vec<WanTarget> {
+    let mut out = Vec::new();
+    let mut seen_marks = HashSet::new();
+    for raw in spec.split(',') {
+        let entry = raw.trim();
+        if entry.is_empty() {
+            continue;
+        }
+        let Some((mark_raw, rest)) = entry.split_once(':') else {
+            continue;
+        };
+        let mark_str = mark_raw.trim();
+        let mark = if let Some(hex) = mark_str
+            .strip_prefix("0x")
+            .or_else(|| mark_str.strip_prefix("0X"))
+        {
+            u32::from_str_radix(hex, 16).ok()
+        } else {
+            mark_str.parse::<u32>().ok()
+        };
+        let Some(mark) = mark.filter(|m| *m != 0) else {
+            continue;
+        };
+
+        let (weight_str, bind_ip) = match rest.split_once('@') {
+            Some((w, ip_str)) => (w.trim(), ip_str.trim().parse::<IpAddr>().ok()),
+            None => (rest.trim(), None),
+        };
+        let Ok(weight) = weight_str.parse::<u32>() else {
+            continue;
+        };
+        if weight == 0 || !seen_marks.insert(mark) {
+            continue;
+        }
+        out.push(WanTarget {
+            mark,
+            weight,
+            bind_ip,
+        });
+    }
+    out
+}
+
+/// Детерминированное распределение `count` слотов по весам методом наибольших остатков.
+fn allocate_counts(targets: &[WanTarget], count: usize) -> Vec<usize> {
+    if targets.is_empty() || count == 0 {
+        return vec![0; targets.len()];
+    }
+    let total_weight: u64 = targets.iter().map(|t| u64::from(t.weight)).sum();
+    if total_weight == 0 {
+        return vec![0; targets.len()];
+    }
+    let mut counts = vec![0usize; targets.len()];
+    let mut remainders: Vec<(usize, u64)> = Vec::with_capacity(targets.len());
+    let mut assigned = 0usize;
+
+    for (idx, target) in targets.iter().enumerate() {
+        let num = u64::from(target.weight) * (count as u64);
+        let base = (num / total_weight) as usize;
+        let rem = num % total_weight;
+        counts[idx] = base;
+        assigned += base;
+        remainders.push((idx, rem));
+    }
+    remainders.sort_by(|a, b| b.1.cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
+    for (idx, _) in remainders.into_iter().take(count.saturating_sub(assigned)) {
+        counts[idx] += 1;
+    }
+    counts
+}
+
+fn target_index_for_slot(targets: &[WanTarget], slot: usize, total_slots: usize) -> Option<usize> {
+    if targets.is_empty() || total_slots == 0 {
+        return None;
+    }
+    let counts = allocate_counts(targets, total_slots);
+    let mut cursor = 0usize;
+    let clamped = slot.min(total_slots.saturating_sub(1));
+    for (idx, &c) in counts.iter().enumerate() {
+        if clamped < cursor + c {
+            return Some(idx);
+        }
+        cursor += c;
+    }
+    Some(0)
+}
+
+impl WanRouter {
+    pub fn new(initial_spec: &str) -> Arc<Self> {
+        let targets = parse_wan_marks(initial_spec);
+        let (tx, _) = watch::channel(0u64);
+        Arc::new(Self {
+            state: RwLock::new(WanState {
+                targets,
+                version: 0,
+                ..Default::default()
+            }),
+            tx,
+            local_proxy_port: Mutex::new(None),
+        })
+    }
+
+    pub fn has_targets(&self) -> bool {
+        !self
+            .state
+            .read()
+            .unwrap_or_else(|e| e.into_inner())
+            .targets
+            .is_empty()
+    }
+
+    /// Возвращает целевой WAN для воркера (1-based `worker_id`) и фиксирует его привязку.
+    /// При `total_workers >= 2 * WORKERS_PER_CREDENTIAL` привязка идёт по когортам (по 10 потоков),
+    /// иначе — пропорционально по воркерам.
+    pub fn assign_worker(&self, worker_id: usize, total_workers: usize) -> Option<WanTarget> {
+        let mut st = self.state.write().unwrap_or_else(|e| e.into_inner());
+        if st.targets.is_empty() {
+            st.worker_marks.remove(&worker_id);
+            return None;
+        }
+        let target = Self::compute_target_locked(&st.targets, worker_id, total_workers)?;
+        st.worker_marks.insert(worker_id, target.mark);
+        st.force_cancel_workers.remove(&worker_id);
+        Some(target)
+    }
+
+    fn compute_target_locked(
+        targets: &[WanTarget],
+        worker_id: usize,
+        total_workers: usize,
+    ) -> Option<WanTarget> {
+        if targets.is_empty() {
+            return None;
+        }
+        let zero_based = worker_id.saturating_sub(1);
+        let use_cohorts = total_workers >= 2 * WORKERS_PER_CREDENTIAL && targets.len() > 1;
+        let (slot, total_slots) = if use_cohorts {
+            let total_cohorts = total_workers.div_ceil(WORKERS_PER_CREDENTIAL);
+            (zero_based / WORKERS_PER_CREDENTIAL, total_cohorts)
+        } else {
+            (zero_based, total_workers.max(1))
+        };
+        let idx = target_index_for_slot(targets, slot, total_slots)?;
+        targets.get(idx).cloned()
+    }
+
+    /// Возвращает `bind_ip` для заданной метки `SO_MARK`.
+    pub fn bind_ip_for_mark(&self, mark: u32) -> Option<IpAddr> {
+        let st = self.state.read().unwrap_or_else(|e| e.into_inner());
+        st.targets
+            .iter()
+            .find(|t| t.mark == mark)
+            .and_then(|t| t.bind_ip)
+    }
+
+    /// Запускает локальный loopback SOCKS5-форвардер (127.0.0.1:0), который применяет SO_MARK и local_ip.
+    pub async fn ensure_local_socks5_proxy(self: &Arc<Self>) -> anyhow::Result<u16> {
+        let mut guard = self.local_proxy_port.lock().await;
+        if let Some(port) = *guard {
+            return Ok(port);
+        }
+        let listener = TcpListener::bind("127.0.0.1:0").await?;
+        let port = listener.local_addr()?.port();
+        *guard = Some(port);
+        drop(guard);
+
+        let router = Arc::clone(self);
+        tokio::spawn(async move {
+            loop {
+                match listener.accept().await {
+                    Ok((stream, _)) => {
+                        let r = Arc::clone(&router);
+                        tokio::spawn(async move {
+                            let _ = handle_socks5_client(stream, r).await;
+                        });
+                    }
+                    Err(e) => {
+                        crate::log_error!("[WAN-SOCKS5] accept error: {e}");
+                        tokio::time::sleep(Duration::from_millis(50)).await;
+                    }
+                }
+            }
+        });
+        Ok(port)
+    }
+
+    /// Возвращает `(socks5://u:<mark_hex>@127.0.0.1:<port>, bind_ip)` для когорты VK API (1-based `credential_id`).
+    pub async fn socks5_proxy_for_credential(
+        self: &Arc<Self>,
+        credential_id: usize,
+        total_workers: usize,
+    ) -> Option<(String, Option<IpAddr>)> {
+        let target = {
+            let st = self.state.read().unwrap_or_else(|e| e.into_inner());
+            if st.targets.is_empty() {
+                return None;
+            }
+            let first_worker_id = credential_id
+                .saturating_sub(1)
+                .saturating_mul(WORKERS_PER_CREDENTIAL)
+                + 1;
+            Self::compute_target_locked(&st.targets, first_worker_id, total_workers)?
+        };
+        let port = self.ensure_local_socks5_proxy().await.ok()?;
+        let url = format!("socks5://u:{:08x}@127.0.0.1:{port}", target.mark);
+        Some((url, target.bind_ip))
+    }
+
+    /// Возвращает `bind_ip` для HTTP-клиента когорты VK API (1-based `credential_id`).
+    pub fn bind_ip_for_credential(
+        &self,
+        credential_id: usize,
+        total_workers: usize,
+    ) -> Option<IpAddr> {
+        let st = self.state.read().unwrap_or_else(|e| e.into_inner());
+        if st.targets.is_empty() {
+            return None;
+        }
+        let first_worker_id = credential_id
+            .saturating_sub(1)
+            .saturating_mul(WORKERS_PER_CREDENTIAL)
+            + 1;
+        Self::compute_target_locked(&st.targets, first_worker_id, total_workers)
+            .and_then(|t| t.bind_ip)
+    }
+
+    pub fn on_worker_ready(&self, worker_id: usize, mark: Option<u32>) {
+        let mut st = self.state.write().unwrap_or_else(|e| e.into_inner());
+        match mark {
+            Some(m) => {
+                st.ready_marks.insert(worker_id, m);
+            }
+            None => {
+                st.ready_marks.remove(&worker_id);
+            }
+        }
+    }
+
+    pub fn on_worker_down(&self, worker_id: usize) {
+        let mut st = self.state.write().unwrap_or_else(|e| e.into_inner());
+        st.ready_marks.remove(&worker_id);
+    }
+
+    pub fn snapshot_wan_streams(&self) -> BTreeMap<String, i32> {
+        let st = self.state.read().unwrap_or_else(|e| e.into_inner());
+        let mut counts: BTreeMap<String, i32> = BTreeMap::new();
+        for t in &st.targets {
+            counts.entry(format!("0x{:08x}", t.mark)).or_insert(0);
+        }
+        for &m in st.ready_marks.values() {
+            *counts.entry(format!("0x{:08x}", m)).or_insert(0) += 1;
+        }
+        counts
+    }
+
+    /// Применяет новую конфигурацию весов/каналов:
+    /// - 0-мс отмена ТОЛЬКО воркеров, сидевших на пропавших марках;
+    /// - плавная (2-3 воркера/с) миграция лишних воркеров при добавлении/изменении весов.
+    pub fn update(self: &Arc<Self>, spec: &str, total_workers: usize) -> WanUpdateOutcome {
+        let next_targets = parse_wan_marks(spec);
+        let next_set: HashSet<u32> = next_targets.iter().map(|t| t.mark).collect();
+
+        let (dropped_marks, rebalance_needed, excess_workers, mig_gen, next_ver) = {
+            let mut st = self.state.write().unwrap_or_else(|e| e.into_inner());
+            if st.targets == next_targets {
+                return WanUpdateOutcome::default();
+            }
+            let prev_set: HashSet<u32> = st.targets.iter().map(|t| t.mark).collect();
+            let dropped: HashSet<u32> = prev_set.difference(&next_set).copied().collect();
+
+            // Мгновенно помечаем для 0-мс отмены только воркеры на упавших марках
+            let mut dropped_workers = Vec::new();
+            for (&wid, &m) in &st.worker_marks {
+                if dropped.contains(&m) {
+                    dropped_workers.push(wid);
+                }
+            }
+            for wid in dropped_workers {
+                st.force_cancel_workers.insert(wid);
+            }
+
+            // Определяем воркеры, чья желаемая марка изменилась (но не из-за drop)
+            let mut excess = Vec::new();
+            for (&wid, &cur_m) in &st.worker_marks {
+                if dropped.contains(&cur_m) {
+                    continue;
+                }
+                let desired =
+                    Self::compute_target_locked(&next_targets, wid, total_workers).map(|t| t.mark);
+                if desired != Some(cur_m) {
+                    excess.push(wid);
+                }
+            }
+            excess.sort_unstable();
+
+            st.targets = next_targets;
+            st.version = st.version.wrapping_add(1);
+            st.migration_gen = st.migration_gen.wrapping_add(1);
+            let rebalance = !excess.is_empty();
+            (dropped, rebalance, excess, st.migration_gen, st.version)
+        };
+
+        let _ = self.tx.send(next_ver);
+
+        // Плавная миграция при hot-plug нового канала или изменении весов (2.5 воркера/с)
+        if !excess_workers.is_empty() {
+            let router = Arc::clone(self);
+            if let Ok(handle) = tokio::runtime::Handle::try_current() {
+                handle.spawn(async move {
+                    for wid in excess_workers {
+                        tokio::time::sleep(Duration::from_millis(400)).await;
+                        let next_v = {
+                            let mut st = router.state.write().unwrap_or_else(|e| e.into_inner());
+                            if st.migration_gen != mig_gen {
+                                return;
+                            }
+                            st.force_cancel_workers.insert(wid);
+                            st.version = st.version.wrapping_add(1);
+                            st.version
+                        };
+                        let _ = router.tx.send(next_v);
+                    }
+                });
+            }
+        }
+
+        WanUpdateOutcome {
+            dropped_marks,
+            rebalance_needed,
+        }
+    }
+
+    /// Ждёт, пока данный воркер не будет помечен к немедленной отмене (0-ms hot-swap или плавная миграция).
+    pub async fn wait_worker_cancel(&self, worker_id: usize) {
+        let mut rx = self.tx.subscribe();
+        loop {
+            {
+                let mut st = self.state.write().unwrap_or_else(|e| e.into_inner());
+                if st.force_cancel_workers.remove(&worker_id) {
+                    return;
+                }
+            }
+            if rx.changed().await.is_err() {
+                std::future::pending::<()>().await;
+            }
+        }
+    }
+}
+
+async fn handle_socks5_client(mut client: TcpStream, router: Arc<WanRouter>) -> anyhow::Result<()> {
+    let _ = client.set_nodelay(true);
+    let mut head = [0u8; 2];
+    client.read_exact(&mut head).await?;
+    if head[0] != 0x05 {
+        anyhow::bail!("unexpected SOCKS version {}", head[0]);
+    }
+    let nmethods = head[1] as usize;
+    let mut methods = vec![0u8; nmethods];
+    client.read_exact(&mut methods).await?;
+
+    let (mark, local_ip) = if methods.contains(&0x02) {
+        client.write_all(&[0x05, 0x02]).await?;
+        let mut auth_head = [0u8; 2];
+        client.read_exact(&mut auth_head).await?;
+        if auth_head[0] != 0x01 {
+            let _ = client.write_all(&[0x01, 0x01]).await;
+            anyhow::bail!("unsupported SOCKS5 auth version {}", auth_head[0]);
+        }
+        let ulen = auth_head[1] as usize;
+        let mut ubuf = vec![0u8; ulen];
+        client.read_exact(&mut ubuf).await?;
+        let mut plen_buf = [0u8; 1];
+        client.read_exact(&mut plen_buf).await?;
+        let mut pbuf = vec![0u8; plen_buf[0] as usize];
+        client.read_exact(&mut pbuf).await?;
+        client.write_all(&[0x01, 0x00]).await?;
+
+        let uname = String::from_utf8_lossy(&ubuf);
+        let passwd = String::from_utf8_lossy(&pbuf);
+        let mark_str = passwd
+            .trim()
+            .trim_start_matches("0x")
+            .trim_start_matches("0X");
+        let parsed_mark = u32::from_str_radix(mark_str, 16)
+            .ok()
+            .filter(|&m| m != 0);
+        let parsed_ip = uname
+            .trim()
+            .parse::<IpAddr>()
+            .ok()
+            .or_else(|| parsed_mark.and_then(|m| router.bind_ip_for_mark(m)));
+        (parsed_mark, parsed_ip)
+    } else if methods.contains(&0x00) {
+        client.write_all(&[0x05, 0x00]).await?;
+        (None, None)
+    } else {
+        let _ = client.write_all(&[0x05, 0xff]).await;
+        anyhow::bail!("no supported SOCKS5 auth methods");
+    };
+
+    let mut req = [0u8; 4];
+    client.read_exact(&mut req).await?;
+    if req[0] != 0x05 || req[1] != 0x01 {
+        let _ = client
+            .write_all(&[0x05, 0x07, 0x00, 0x01, 0, 0, 0, 0, 0, 0])
+            .await;
+        anyhow::bail!("unsupported SOCKS5 command {}", req[1]);
+    }
+
+    let mut addrs: Vec<SocketAddr> = match req[3] {
+        0x01 => {
+            let mut buf = [0u8; 6];
+            client.read_exact(&mut buf).await?;
+            let ip = Ipv4Addr::new(buf[0], buf[1], buf[2], buf[3]);
+            let port = u16::from_be_bytes([buf[4], buf[5]]);
+            vec![SocketAddr::new(IpAddr::V4(ip), port)]
+        }
+        0x03 => {
+            let mut len_buf = [0u8; 1];
+            client.read_exact(&mut len_buf).await?;
+            let mut host_buf = vec![0u8; len_buf[0] as usize];
+            client.read_exact(&mut host_buf).await?;
+            let mut port_buf = [0u8; 2];
+            client.read_exact(&mut port_buf).await?;
+            let host = String::from_utf8(host_buf)?;
+            let port = u16::from_be_bytes(port_buf);
+            let mut resolved: Vec<SocketAddr> = tokio::net::lookup_host((host.as_str(), port))
+                .await?
+                .collect();
+            if local_ip.is_some_and(|ip| ip.is_ipv4()) {
+                resolved.sort_by_key(|a| if a.is_ipv4() { 0 } else { 1 });
+            }
+            resolved
+        }
+        0x04 => {
+            let mut buf = [0u8; 18];
+            client.read_exact(&mut buf).await?;
+            let mut octets = [0u8; 16];
+            octets.copy_from_slice(&buf[..16]);
+            let ip = Ipv6Addr::from(octets);
+            let port = u16::from_be_bytes([buf[16], buf[17]]);
+            vec![SocketAddr::new(IpAddr::V6(ip), port)]
+        }
+        atyp => {
+            let _ = client
+                .write_all(&[0x05, 0x08, 0x00, 0x01, 0, 0, 0, 0, 0, 0])
+                .await;
+            anyhow::bail!("unsupported SOCKS5 ATYP {atyp}");
+        }
+    };
+
+    if addrs.is_empty() {
+        let _ = client
+            .write_all(&[0x05, 0x04, 0x00, 0x01, 0, 0, 0, 0, 0, 0])
+            .await;
+        anyhow::bail!("no resolved addresses for SOCKS5 target");
+    }
+
+    let mut connected: Option<TcpStream> = None;
+    let mut last_err: Option<anyhow::Error> = None;
+    for addr in addrs.drain(..).take(4) {
+        match tokio::time::timeout(
+            Duration::from_secs(15),
+            crate::turn_stream::connect_tcp_marked(addr, mark, local_ip),
+        )
+        .await
+        {
+            Ok(Ok(stream)) => {
+                connected = Some(stream);
+                break;
+            }
+            Ok(Err(e)) => last_err = Some(e),
+            Err(_) => last_err = Some(anyhow::anyhow!("connect timeout to {addr}")),
+        }
+    }
+
+    let mut upstream = match connected {
+        Some(s) => s,
+        None => {
+            let _ = client
+                .write_all(&[0x05, 0x05, 0x00, 0x01, 0, 0, 0, 0, 0, 0])
+                .await;
+            return Err(last_err.unwrap_or_else(|| anyhow::anyhow!("upstream connect failed")));
+        }
+    };
+
+    let _ = upstream.set_nodelay(true);
+    client
+        .write_all(&[0x05, 0x00, 0x00, 0x01, 0, 0, 0, 0, 0, 0])
+        .await?;
+    let _ = tokio::io::copy_bidirectional(&mut client, &mut upstream).await;
+    Ok(())
+}
