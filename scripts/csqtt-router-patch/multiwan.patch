+
+    #[test]
+    fn parse_wan_marks_supports_hex_dec_and_ip() {
+        let parsed = parse_wan_marks("0x10000000:60@192.168.10.22, 0x20000000:40@192.168.2.52, 0x30000000:0");
+        assert_eq!(parsed.len(), 2);
+        assert_eq!(parsed[0].mark, 0x1000_0000);
+        assert_eq!(parsed[0].weight, 60);
+        assert_eq!(
+            parsed[0].bind_ip,
+            Some("192.168.10.22".parse::<IpAddr>().unwrap())
+        );
+        assert_eq!(parsed[1].mark, 0x2000_0000);
+        assert_eq!(parsed[1].weight, 40);
+    }
+
+    #[test]
+    fn worker_and_cohort_distribution_follows_weights() {
+        let router = WanRouter::new("0x10000000:60@192.168.10.22,0x20000000:40@192.168.2.52");
+        let mut c1 = 0;
+        let mut c2 = 0;
+        for wid in 1..=20 {
+            let t = router.assign_worker(wid, 20).unwrap();
+            if t.mark == 0x1000_0000 {
+                c1 += 1;
+            } else {
+                c2 += 1;
+            }
+        }
+        // 20 воркеров = 2 когорты по 10 воркеров -> когорта 1 на 0x10000000, когорта 2 на 0x20000000
+        assert_eq!(c1, 10);
+        assert_eq!(c2, 10);
+        assert_eq!(
+            router.bind_ip_for_credential(1, 20),
+            Some("192.168.10.22".parse().unwrap())
+        );
+        assert_eq!(
+            router.bind_ip_for_credential(2, 20),
+            Some("192.168.2.52".parse().unwrap())
+        );
+    }
+
+    #[test]
+    fn zero_ms_hotswap_cancels_only_dropped_mark_workers() {
+        let router = WanRouter::new("0x10000000:50,0x20000000:50");
+        for wid in 1..=20 {
+            let t = router.assign_worker(wid, 20).unwrap();
+            router.on_worker_ready(wid, Some(t.mark));
+        }
+        assert_eq!(router.snapshot_wan_streams().get("0x10000000"), Some(&10));
+        assert_eq!(router.snapshot_wan_streams().get("0x20000000"), Some(&10));
+
+        let outcome = router.update("0x10000000:100", 20);
+        assert!(outcome.dropped_marks.contains(&0x2000_0000));
+        let st = router.state.read().unwrap();
+        // Только воркеры 11..=20 (сидевшие на 0x20000000) помечены к 0-мс отмене
+        for wid in 1..=10 {
+            assert!(!st.force_cancel_workers.contains(&wid));
+        }
+        for wid in 11..=20 {
+            assert!(st.force_cancel_workers.contains(&wid));
+        }
+    }
+
+    #[tokio::test]
+    async fn socks5_proxy_for_credential_maps_cohorts_to_distinct_marks_and_ips() {
+        let empty = WanRouter::new("");
+        assert!(empty.socks5_proxy_for_credential(1, 20).await.is_none());
+
+        let router = WanRouter::new("0x10000000:50@192.168.10.22,0x20000000:50@192.168.2.52");
+        let (url1, ip1) = router.socks5_proxy_for_credential(1, 20).await.unwrap();
+        let (url2, ip2) = router.socks5_proxy_for_credential(2, 20).await.unwrap();
+        assert!(url1.starts_with("socks5://u:10000000@127.0.0.1:"), "{url1}");
+        assert!(url2.starts_with("socks5://u:20000000@127.0.0.1:"), "{url2}");
+        assert_eq!(ip1, Some("192.168.10.22".parse().unwrap()));
+        assert_eq!(ip2, Some("192.168.2.52".parse().unwrap()));
+    }
+
+    #[tokio::test]
+    async fn socks5_forwarder_handles_ipv4_domain_and_ipv6_with_auth() {
+        // Echo TCP server on 127.0.0.1
+        let echo_v4 = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let echo_v4_addr = echo_v4.local_addr().unwrap();
+        tokio::spawn(async move {
+            loop {
+                let Ok((mut s, _)) = echo_v4.accept().await else {
+                    break;
+                };
+                tokio::spawn(async move {
+                    let mut buf = [0u8; 64];
+                    if let Ok(n) = s.read(&mut buf).await {
+                        let _ = s.write_all(&buf[..n]).await;
+                    }
+                });
+            }
+        });
+
+        let router = WanRouter::new("0x10000000:100@127.0.0.1");
+        let port = router.ensure_local_socks5_proxy().await.unwrap();
+
+        // 1. ATYP 0x01 (IPv4) with username/password auth (0x02)
+        {
+            let mut cli = TcpStream::connect(("127.0.0.1", port)).await.unwrap();
+            cli.write_all(&[0x05, 0x01, 0x02]).await.unwrap();
+            let mut m = [0u8; 2];
+            cli.read_exact(&mut m).await.unwrap();
+            assert_eq!(m, [0x05, 0x02]);
+
+            let uname = b"u";
+            let passwd = b"10000000";
+            let mut auth = vec![0x01, uname.len() as u8];
+            auth.extend_from_slice(uname);
+            auth.push(passwd.len() as u8);
+            auth.extend_from_slice(passwd);
+            cli.write_all(&auth).await.unwrap();
+            let mut ares = [0u8; 2];
+            cli.read_exact(&mut ares).await.unwrap();
+            assert_eq!(ares, [0x01, 0x00]);
+
+            let ip = match echo_v4_addr.ip() {
+                IpAddr::V4(v4) => v4.octets(),
+                _ => unreachable!(),
+            };
+            let mut req = vec![0x05, 0x01, 0x00, 0x01];
+            req.extend_from_slice(&ip);
+            req.extend_from_slice(&echo_v4_addr.port().to_be_bytes());
+            cli.write_all(&req).await.unwrap();
+            let mut rep = [0u8; 10];
+            cli.read_exact(&mut rep).await.unwrap();
+            assert_eq!(rep[1], 0x00);
+
+            cli.write_all(b"ping-v4").await.unwrap();
+            let mut echo = [0u8; 7];
+            cli.read_exact(&mut echo).await.unwrap();
+            assert_eq!(&echo, b"ping-v4");
+        }
+
+        // 2. ATYP 0x03 (Domain "localhost") with no-auth (0x00)
+        {
+            let mut cli = TcpStream::connect(("127.0.0.1", port)).await.unwrap();
+            cli.write_all(&[0x05, 0x01, 0x00]).await.unwrap();
+            let mut m = [0u8; 2];
+            cli.read_exact(&mut m).await.unwrap();
+            assert_eq!(m, [0x05, 0x00]);
+
+            let dom = b"127.0.0.1";
+            let mut req = vec![0x05, 0x01, 0x00, 0x03, dom.len() as u8];
+            req.extend_from_slice(dom);
+            req.extend_from_slice(&echo_v4_addr.port().to_be_bytes());
+            cli.write_all(&req).await.unwrap();
+            let mut rep = [0u8; 10];
+            cli.read_exact(&mut rep).await.unwrap();
+            assert_eq!(rep[1], 0x00);
+
+            cli.write_all(b"ping-dom").await.unwrap();
+            let mut echo = [0u8; 8];
+            cli.read_exact(&mut echo).await.unwrap();
+            assert_eq!(&echo, b"ping-dom");
+        }
+
+        // 3. ATYP 0x04 (IPv6 [::1]) if IPv6 loopback is available
+        if let Ok(echo_v6) = TcpListener::bind("[::1]:0").await {
+            let echo_v6_addr = echo_v6.local_addr().unwrap();
+            tokio::spawn(async move {
+                if let Ok((mut s, _)) = echo_v6.accept().await {
+                    let mut buf = [0u8; 64];
+                    if let Ok(n) = s.read(&mut buf).await {
+                        let _ = s.write_all(&buf[..n]).await;
+                    }
+                }
+            });
+            let mut cli = TcpStream::connect(("127.0.0.1", port)).await.unwrap();
+            cli.write_all(&[0x05, 0x01, 0x00]).await.unwrap();
+            let mut m = [0u8; 2];
+            cli.read_exact(&mut m).await.unwrap();
+            assert_eq!(m, [0x05, 0x00]);
+
+            let ip6 = match echo_v6_addr.ip() {
+                IpAddr::V6(v6) => v6.octets(),
+                _ => unreachable!(),
+            };
+            let mut req = vec![0x05, 0x01, 0x00, 0x04];
+            req.extend_from_slice(&ip6);
+            req.extend_from_slice(&echo_v6_addr.port().to_be_bytes());
+            cli.write_all(&req).await.unwrap();
+            let mut rep = [0u8; 10];
+            cli.read_exact(&mut rep).await.unwrap();
+            assert_eq!(rep[1], 0x00);
+
+            cli.write_all(b"ping-v6").await.unwrap();
+            let mut echo = [0u8; 7];
+            cli.read_exact(&mut echo).await.unwrap();
+            assert_eq!(&echo, b"ping-v6");
+        }
+
+        // 4. End-to-end primp Client through socks5://u:<mark>@127.0.0.1:<port>
+        let http_listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let http_addr = http_listener.local_addr().unwrap();
+        tokio::spawn(async move {
+            if let Ok((mut s, _)) = http_listener.accept().await {
+                let mut buf = [0u8; 1024];
+                let _ = s.read(&mut buf).await;
+                let _ = s
+                    .write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
+                    .await;
+            }
+        });
+        let (proxy_url, _) = router.socks5_proxy_for_credential(1, 10).await.unwrap();
+        let client = primp::Client::builder()
+            .proxy(primp::Proxy::all(&proxy_url).unwrap())
+            .build()
+            .unwrap();
+        let body = client
+            .get(format!("http://{http_addr}/test"))
+            .send()
+            .await
+            .unwrap()
+            .text()
+            .await
+            .unwrap();
+        assert_eq!(body, "ok");
+    }
+}
