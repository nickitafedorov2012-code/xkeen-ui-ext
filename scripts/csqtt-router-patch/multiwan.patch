+pub(crate) async fn connect_tcp_marked(
+    server: SocketAddr,
+    wan_mark: Option<u32>,
+    local_ip: Option<IpAddr>,
+) -> Result<TcpStream> {
+    let bind_ip = local_ip.filter(|ip| !server.ip().is_loopback() && ip.is_ipv4() == server.is_ipv4());
+    #[cfg(target_os = "linux")]
+    if wan_mark.is_some() || bind_ip.is_some() {
+        let socket = if server.is_ipv4() {
+            tokio::net::TcpSocket::new_v4().context("TURN TCP socket v4")?
+        } else {
+            tokio::net::TcpSocket::new_v6().context("TURN TCP socket v6")?
+        };
+        if let Some(mark) = wan_mark {
+            SockRef::from(&socket)
+                .set_mark(mark)
+                .with_context(|| format!("TURN TCP SO_MARK 0x{mark:x}"))?;
+        }
+        if let Some(ip) = bind_ip {
+            socket
+                .bind(SocketAddr::new(ip, 0))
+                .with_context(|| format!("TURN TCP bind {ip}"))?;
+        }
+        return socket
+            .connect(server)
+            .await
+            .context("TURN TCP marked socket connect");
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        let _ = wan_mark;
+        if let Some(ip) = bind_ip {
